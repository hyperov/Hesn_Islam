<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:layoutDirection="rtl">

    <TextView
        android:id="@+id/item_num"
        android:layout_width="@dimen/vertical_margin_48"
        android:layout_height="@dimen/vertical_margin_48"
        android:fontFamily="@font/a_nefel_botan"
        android:layout_marginVertical="@dimen/vertical_margin_16"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="@dimen/vertical_margin_16"
        android:background="@drawable/ic_number_placeholder"
        android:gravity="center"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="@dimen/text_size_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="1" />

    <TextView
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/text_margin"
        android:layout_marginStart="16dp"
        android:fontFamily="@font/a_nefel_botan"
        android:gravity="center_vertical"
        android:lineSpacingMultiplier="1.5"
        android:textAppearance="?attr/textAppearanceListItem"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="@dimen/text_size_18"
        app:layout_constraintBottom_toBottomOf="@+id/item_num"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/item_num"
        app:layout_constraintTop_toTopOf="@+id/item_num"
        tools:text="موسى" />

    <TextView
        android:id="@+id/tvTranslateBible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/janna_bold"
        android:textSize="12sp"
        android:text="@string/click_for_translation"
        app:layout_constraintStart_toStartOf="@+id/content"
        app:layout_constraintTop_toBottomOf="@+id/content" />
</androidx.constraintlayout.widget.ConstraintLayout>
