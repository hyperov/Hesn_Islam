<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:autoTransition="animateToEnd"
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@id/start"
        motion:duration="800"
        motion:motionInterpolator="linear">
        <KeyFrameSet>
            <KeyAttribute
                android:alpha="0"
                android:rotationX="180"
                android:rotationY="180"
                android:scaleX="0"
                android:scaleY="0"
                motion:framePosition="0"
                motion:motionTarget="@+id/quran" />
            <KeyAttribute
                android:alpha="0"
                android:rotationX="180"
                android:rotationY="180"
                android:scaleX="0"
                android:scaleY="0"
                motion:framePosition="0"
                motion:motionTarget="@+id/bible" />
            <KeyAttribute
                android:alpha="1"
                android:scaleX="1"
                android:scaleY="1"
                motion:framePosition="90"
                motion:motionTarget="@+id/quran" />
            <KeyAttribute
                android:alpha="1"
                android:scaleX="1"
                android:scaleY="1"
                motion:framePosition="90"
                motion:motionTarget="@+id/bible" />
            <KeyAttribute
                android:alpha="0"
                android:rotationX="270"
                android:rotationY="270"
                android:translationY="900dp"
                motion:framePosition="0"
                motion:motionTarget="@+id/youtube" />
            <KeyAttribute
                android:rotationX="270"
                android:rotationY="270"
                android:translationY="900dp"
                motion:framePosition="0"
                motion:motionTarget="@+id/about" />
            <KeyAttribute
                android:rotationX="270"
                android:rotationY="270"
                android:translationY="1000dp"
                motion:framePosition="0"
                motion:motionTarget="@+id/misconceptions" />
            <KeyAttribute
                android:rotationX="270"
                android:rotationY="270"
                android:translationY="1000dp"
                motion:framePosition="0"
                motion:motionTarget="@+id/reply" />
        </KeyFrameSet>
    </Transition>

    <ConstraintSet android:id="@+id/start"></ConstraintSet>

    <ConstraintSet android:id="@+id/end"></ConstraintSet>

</MotionScene>