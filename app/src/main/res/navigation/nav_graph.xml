<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/youtubeFragment">

    <fragment
        android:id="@+id/quranFragment"
        android:name="com.islam.hesn.myapplication.quran.view.QuranFragment"
        android:label="@string/quran"
        tools:layout="@layout/fragment_quran_list">
        <action
            android:id="@+id/action_quranFragment_to_surahFragment"
            app:destination="@id/surahFragment" />
        <action
            android:id="@+id/action_quranFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
    </fragment>
    <fragment
        android:id="@+id/surahFragment"
        android:name="com.islam.hesn.myapplication.quran.view.SurahFragment"
        android:label="fragment_surah"
        tools:layout="@layout/fragment_surah" />
    <fragment
        android:id="@+id/bibleFragment"
        android:name="com.islam.hesn.myapplication.bible.view.fragment.BibleFragment"
        android:label="@string/bible"
        tools:layout="@layout/fragment_bible_list">
        <action
            android:id="@+id/action_bibleFragment_to_bookFragment"
            app:destination="@id/bookFragment" />
        <action
            android:id="@+id/action_bibleFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
    </fragment>
    <fragment
        android:id="@+id/bookFragment"
        android:name="com.islam.hesn.myapplication.bible.view.fragment.BookFragment"
        android:label="book_fragment"
        tools:layout="@layout/fragment_book">
        <action
            android:id="@+id/action_bookFragment_to_chapterFragment"
            app:destination="@id/chapterFragment" />
    </fragment>
    <fragment
        android:id="@+id/chapterFragment"
        android:name="com.islam.hesn.myapplication.bible.view.fragment.ChapterFragment"
        android:label="fragment_chapter"
        tools:layout="@layout/fragment_chapter" />
    <fragment
        android:id="@+id/youtubeFragment"
        android:name="com.islam.hesn.myapplication.youtube.view.YoutubeFragment"
        android:label="@string/youtube_channel"
        tools:layout="@layout/fragment_youtube">
        <action
            android:id="@+id/action_youtubeFragment_to_youtubePlayerFragment"
            app:destination="@id/youtubePlayerFragment" />
    </fragment>
    <fragment
        android:id="@+id/misconceptionsFragment"
        android:name="com.islam.hesn.myapplication.misconceptions.MisconceptionsFragment"
        android:label="@string/misconceptions"
        tools:layout="@layout/fragment_misconceptions" />
    <fragment
        android:id="@+id/moreFragment"
        android:name="com.islam.hesn.myapplication.more.MoreFragment"
        android:label="@string/more"
        tools:layout="@layout/fragment_more" />
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.islam.hesn.myapplication.search.view.SearchFragment"
        android:label="@string/search_title"
        tools:layout="@layout/search_fragment" />
    <fragment
        android:id="@+id/youtubePlayerFragment"
        android:name="com.islam.hesn.myapplication.youtube.view.YoutubePlayerFragment"
        android:label="YoutubePlayerFragment"
        tools:layout="@layout/fragment_youtube_player" />
</navigation>